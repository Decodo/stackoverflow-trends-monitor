# Backend
PORT=5002
PUBLIC_API_BASE_URL=http://localhost:5002
PUBLIC_FRONTEND_URL=http://localhost:5274

# Database
MONGO_PORT=27018
REDIS_PORT=6378
MONGODB_URI=mongodb://localhost:27018/platform

# Decodo residential proxy (required for Playwright deep dives)
DECODO_PROXY_USERNAME=
DECODO_PROXY_PASSWORD=
DECODO_PROXY_HOST=gate.decodo.com
DECODO_PROXY_PORT=7000
# Playwright uses the locally installed Google Chrome by default. Set blank only if
# you intentionally install and use Playwright's bundled Chromium.
PLAYWRIGHT_CHANNEL=chrome

# LLM Provider — pick one: claude | openai | gemini
LLM_PROVIDER=claude
LLM_MODEL=          # optional model override; leave blank for provider default

# API keys — only the key for your chosen LLM_PROVIDER is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
